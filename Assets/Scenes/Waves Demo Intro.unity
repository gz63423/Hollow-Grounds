  m_Script: {fileID: 11500000, guid: 3a2395428ca7d7c4aa328360281414a7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  blackImage: {fileID: 79763579}
  fadeDuration: 5
  musicDelay: 1
  musicFadeDuration: 4
  dialogueBox: {fileID: 1180998368}
  dialogueDelay: 1
  dialogueFadeDuration: 1
  dialogueText: {fileID: 419530741}
  dialogueLines:
  - Welcome to The Hollow Grounds.
  - Before we begin, keep in mind that this is a demo version of the game.
  - Your progress in the demo will not carry over to the full release.
  - "With that out of the way, let\u2019s get started."
  - "First, let\u2019s learn the basics of movement."
  characterDelay: 0.04
  dialogueBox2: {fileID: 800357129}
  dialogueBox2Delay: 1
  dialogueBox2FadeDuration: 1
  dialogueText2: {fileID: 2004658428}
  dialogueLines2Part1:
  - 'Use WASD to move around.


    Try moving up, down, left, and right to get familiar
    with your surroundings.'
  characterDelay2Part1: 0.04
  dialogueText2Part2: {fileID: 2106673512}
  dialogueLines2Part2:
  - 'Great job! You''ve got the basics of movement down.


    Now let''s work on
    sprinting.'
  characterDelay2Part2: 0.04
  dialogue2Tab: {fileID: 592845098}
  dialogue2TabFadeDuration: 2
  dialogue2TabFadeOutDuration: 1
  dialogueBox3: {fileID: 1758387489}
  dialogueBox3FadeDuration: 1
  dialogueBox3Delay: 1
  dialogueText3: {fileID: 1512421525}
  dialogueLines3:
  - 'Hold left SHIFT while moving to sprint.


    Give it a try and get used to
    moving at a faster pace.'
  characterDelay3: 0.04
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
